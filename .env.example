# Database
DATABASE_URL="postgresql://milven:milven@localhost:5432/milven?schema=public"

# Public site URL (used for canonical URLs, sitemap, OpenGraph, JSON-LD)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contact email sending via Resend
RESEND_API_KEY=""
CONTACT_TO_EMAIL="advisory@milven.co.zw"
CONTACT_FROM_EMAIL="Milven Website <website@your-confirmed-domain.com>"

# Optional: Cloudflare Turnstile anti-spam (leave blank to disable)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Add authentication before production
NEXTAUTH_SECRET="change-this"
NEXTAUTH_URL="http://localhost:3000"

# Admin CMS authentication (used to seed the first administrator account)
AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="advisory@milven.co.zw"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_NAME="Milven Administrator"
