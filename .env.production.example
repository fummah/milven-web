# Production environment for the server (place as `.env` in the deploy directory).
# The CI/CD deploy job updates the image tag via the IMAGE variable, so you do
# not normally set IMAGE here.

# --- Database (Postgres container) ---
POSTGRES_DB=milven
POSTGRES_USER=milven
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- Public site URL (also baked into the image at build time) ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Auth ---
AUTH_SECRET=replace-with-a-long-random-secret

# --- First administrator (seeded on demand, see README) ---
ADMIN_EMAIL=advisory@milven.co.zw
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Milven Administrator

# --- Contact email (Resend) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=advisory@milven.co.zw
CONTACT_FROM_EMAIL=Milven Website <website@your-domain.com>

# --- Optional Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Host port (the app listens on 3000 inside the container) ---
APP_PORT=3000
