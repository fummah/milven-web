# Production environment for the server (place as `.env` in the deploy directory).
# The CI/CD deploy job overrides IMAGE at run time; it is used for manual
# `docker compose run ...` commands.

# --- Container image (GitHub owner/repo, lowercased) ---
IMAGE=ghcr.io/fummah/milven-web:latest

# --- Database (Postgres container) ---
POSTGRES_DB=milven
POSTGRES_USER=milven
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- Public site URL (also baked into the image at build time) ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Auth ---
AUTH_SECRET=replace-with-a-long-random-secret

# --- First administrator (seeded on demand, see README) ---
ADMIN_EMAIL=advisory@milven.co.zw
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Milven Administrator

# --- Contact email (Resend legacy fallback; Graph is configured in the CMS) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=advisory@milven.co.zw
CONTACT_FROM_EMAIL=Milven Website <website@your-domain.com>

# --- Encryption key for CMS secrets (Microsoft client secret) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_SECRET_KEY=

# --- Optional Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional analytics (Google Analytics 4) ---
NEXT_PUBLIC_GA_ID=

# --- Optional CRM / marketing automation webhook (Zapier, Make, HubSpot...) ---
CRM_WEBHOOK_URL=

# --- Host port (the app listens on 3000 inside the container) ---
APP_PORT=3000
